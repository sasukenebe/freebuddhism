  <div id="sutta">
  
            <h4 id="thag1.21" class="h1">Thag 1:21  Nigrodha</h4>
            <div class="verse">
              <p>I’m not afraid</p>
              <p class="v6">of danger,</p>
              <p class="v6">of fear.</p>
              <p>Our Teacher’s adept</p>
              <p>in the deathless.</p>
              <p>Where danger, where fear</p>
              <p>do not remain:</p>
              <p class="v1">That’s the path</p>
              <p class="v1">by which the monks go.</p>
            </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
