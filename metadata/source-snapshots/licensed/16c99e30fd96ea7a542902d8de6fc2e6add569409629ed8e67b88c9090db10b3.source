  <div id="sutta">
  
            <h4 id="thag1.6" class="h1">Thag 1:6  Dabba (“Capable”)</h4>
            <div class="verse">
              <p>Whoever,</p>
              <p>hard to tame,</p>
              <p>has been tamed by taming,</p>
              <p>—capable, contented,</p>
              <p>crossed over doubt,</p>
              <p>victorious, as his fears</p>
              <p>are dispersed:</p>
              <p><em>He</em> is capable,</p>
              <p>unbound,</p>
              <p>steadfast in mind.</p>
            </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
