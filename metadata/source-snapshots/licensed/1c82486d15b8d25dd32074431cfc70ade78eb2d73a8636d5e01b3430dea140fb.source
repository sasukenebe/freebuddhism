  <div id="sutta">
  
    <h4 id="thag1.101" class="h1">Thag 1:101  Belaṭṭhkāni</h4>
            <div class="verse">
              <p>Abandoning the householder’s state,</p>
              <p>but with no mastery,</p>
              <p>lazy, gluttonous,</p>
              <p>using his mouth as a plough</p>
              <p>like a great hog fattened on fodder:</p>
              <p class="v2">Again &amp; again</p>
              <p>he goes to the womb—</p>
              <p class="v2">the dullard.</p>
            </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
     <!--#include virtual="/php/suttafooter.html" --> 

</div><!--end:container-->

