  <div id="sutta">
  
            <h4 id="thag1.120" class="h1">Thag 1:120  Isidatta</h4>
            <div class="verse">
              <p>The five aggregates,</p>
              <p>having been comprehended,</p>
              <p>stand with their root</p>
              <p class="v2">cut through.</p>
              <p>For me</p>
              <p class="v2">the ending of stress</p>
              <p class="v4">is reached;</p>
              <p class="v2">the ending of effluents,</p>
              <p class="v4">attained.</p>
            </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
     <!--#include virtual="/php/suttafooter.html" --> 

</div><!--end:container-->

