  <div id="sutta">
  
    <h4 id="thag2.13" class="h1">Thag 2:13  Heraññakāni</h4>
            <div class="verse">
              <p>Days &amp; nights</p>
              <p class="v4">fly past.</p>
              <p>Life</p>
              <p class="v2">comes to an end.</p>
              <p>The span of mortals</p>
              <p class="v4">runs out,</p>
              <p>like the water of a piddling stream.</p>
              <div class="verse-add">
                <p>But the fool doing evil deeds</p>
                <p>doesn’t realize that later</p>
                <p>it’s bitter for him:</p>
                <p>evil for him</p>
                <p class="v4">the result.</p>
              </div><!--end verse-add-->
            </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
