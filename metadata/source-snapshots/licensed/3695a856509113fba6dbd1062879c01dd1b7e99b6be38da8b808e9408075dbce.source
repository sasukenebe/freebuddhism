  <div id="sutta">
  
            <h4 id="thag1.61" class="h1">Thag 1:61  Vappa</h4>
            <div class="verse">
              <p>One who sees</p>
              <p class="v1">sees who sees,</p>
              <p class="v1">sees who doesn’t.</p>
              <p>One who doesn’t see</p>
              <p class="v3">doesn’t</p>
              <p class="v1">see who sees</p>
              <p class="v1">or who doesn’t.</p>
            </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
