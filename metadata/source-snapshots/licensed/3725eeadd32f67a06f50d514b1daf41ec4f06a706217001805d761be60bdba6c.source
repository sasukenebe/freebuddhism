  <div id="sutta">
  
    <h4 id="thag1.3" class="h1">Thag 1:3  Kaṅkhā (Doubting) Revata</h4>
            <div class="verse">
              <p class="v2">See this:</p>
              <p>the discernment</p>
              <p>of the Tathāgatas,</p>
              <p>like a fire ablaze in the night,</p>
              <p>giving light, giving eyes,</p>
              <p>to those who come,</p>
              <p>subduing their doubt.</p>
            </div><!--end verse-->
      </div><!--end:sutta-->
