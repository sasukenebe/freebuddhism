     <!--#include virtual="/php/suttasidebar.html" --> 

        <div id="sutta">
          <h3 id="chap-thig" class="chap">Therīgāthā<br/><span class="small">Poems of the Elder Nuns</span></h3>
          <h4 id="thig1.1" class="h1">Thig 1:1  An Anonymous Nun</h4>
          <div class="verse">
            <p>Sleep, little therī, sleep comfortably,</p>
            <p>wrapped in the robe you’ve made,</p>
            <p>for your passion is stilled—</p>
            <p class="v2">like a pot of pickled greens</p>
            <p class="v2">boiled dry.</p>
          </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
