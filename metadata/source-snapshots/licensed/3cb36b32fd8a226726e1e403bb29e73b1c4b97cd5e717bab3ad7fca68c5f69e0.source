     <!--#include virtual="/php/suttasidebar.html" --> 

        <div id="sutta">
            <h3 id="chap-thag" class="chap">Theragāthā<br/><span class="small">Poems of the Elder Monks</span></h3>
            <h4 id="thag1.1" class="h1">Thag 1:1  Subhūti</h4>
            <div class="verse">
              <p>My hut is roofed, comfortable,</p>
              <p class="v2">free of drafts;</p>
              <p>my mind, well-centered,</p>
              <p class="v2">released.</p>
              <p>I remain ardent.</p>
              <p class="v2">So, rain-deva.</p>
              <p class="v2">Go ahead &amp; rain.</p>
            </div><!--end verse-->
            <p class="seealso">See also: <a href="../../AN/AN3_110.html">AN 3:110</a>; <a href="../StNp/StNp1_1.html">Sn 1:1</a></p><!--end seealso-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
