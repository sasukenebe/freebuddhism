  <div id="sutta">
  
    <h4 id="thag1.57" class="h1">Thag 1:57  Kuṭivihārin (2)</h4>
            <div class="verse">
              <p>This was your old hut,</p>
              <p class="v2">and you aspire to another,</p>
              <p class="v4">new hut.</p>
              <p>Discard your hope for a hut, monk.</p>
              <p>A new hut will be</p>
              <p class="v2">painful all over again.<span class="fn"><a href="#thag1.57note01">1</a></span><!--end fn cite--></p>
            </div><!--end verse-->
            <div class="note">
              <p class="notetitle">Note</p><!--end notetitle-->
              <p id="thag1.57note01">1. See <a href="thag2_32.html#thag2.32note01">Thag 2:32, note 1</a>.</p>
            </div><!--end notes-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
