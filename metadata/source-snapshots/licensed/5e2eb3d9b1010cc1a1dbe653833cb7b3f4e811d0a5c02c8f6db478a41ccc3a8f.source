  <div id="sutta">
  
    <h4 id="thag1.29" class="h1">Thag 1:29  Hārita</h4>
            <div class="verse">
              <p class="v2">Hārita,</p>
              <p>raise yourself up-</p>
              <p class="v2">right</p>
              <p>and, straightening your mind</p>
              <p>—like a fletcher, an arrow—</p>
              <p class="v2">shatter ignorance</p>
              <p class="v4">to bits.</p>
            </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
