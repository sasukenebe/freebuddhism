     <!--#include virtual="/php/suttasidebar.html" --> 

  <div id="sutta">
  
            <h4 id="thag2.24" class="h1">Thag 2:24  Valliya</h4>
            <div class="verse">
              <p>What needs to be done</p>
              <p>with firm persistence,</p>
              <p>what needs to be done</p>
              <p>by one who hopes for awakening,</p>
              <p class="v2">that I will do.</p>
              <p class="v2">I will not fail.</p>
              <p>See: persistence &amp; striving!</p>
              <div class="verse-add">
                <p>You show me the path:</p>
                <p class="v2">the straight,</p>
                <p class="v2">the plunge into deathlessness.</p>
                <p>I, through sagacity,</p>
                <p>will reach it, know it,</p>
                <p>as the stream of the Ganges,</p>
                <p class="v2">the sea.</p>
              </div><!--end verse-add-->
            </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
