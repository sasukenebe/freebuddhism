     <!--#include virtual="/php/suttasidebar.html" --> 

  <div id="sutta">
  
    <h4 id="thag3.15" class="h1">Thag 3:15  Hārita</h4>
            <div class="verse">
              <p>Whoever wants to do later</p>
              <p>what he should have done first,</p>
              <p>falls away from the easeful state</p>
              <p class="v2">&amp; later repents.</p>
              <div class="verse-add">
                <p>One should speak</p>
                <p>as one would act,</p>
                <p>&amp; not</p>
                <p>as one wouldn’t.</p>
                <p>When one speaks without acting,</p>
                <p>the wise, they can tell.</p>
              </div><!--end verse-add-->
              <div class="verse-add">
                <p>How very easeful:</p>
                <p class="v2">unbinding,</p>
                <p>as taught by the Rightly</p>
                <p>Self-awakened One—</p>
                <p class="v4">sorrowless,</p>
                <p class="v4">dustless,</p>
                <p class="v4">secure,</p>
                <p>where stress</p>
                <p>&amp; suffering</p>
                <p>cease.</p>
              </div><!--end verse-add-->
            </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
     <!--#include virtual="/php/suttafooter.html" --> 

</div><!--end:container-->

