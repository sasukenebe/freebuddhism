  <div id="sutta">
  
            <h4 id="thag3.13" class="h1">Thag 3:13  Abhibhūta</h4>
            <div class="verse">
              <p>Listen, kinsmen, all of you,</p>
              <p>as many as are assembled here.</p>
              <p>I will teach you the Dhamma:</p>
              <p class="v2">Painful is birth,</p>
              <p class="v2">again &amp; again.</p>
              <div class="verse-add">
                <p>Rouse yourselves.</p>
                <p class="v2">Go forth.</p>
                <p>Apply yourselves</p>
                <p>to the Awakened One’s bidding.</p>
                <p>Scatter the army of Death</p>
                <p>as an elephant would</p>
                <p>a shed made of reeds.</p>
              </div><!--end verse-add-->
              <div class="verse-add">
                <p>He who,</p>
                <p>in this Dhamma &amp; Vinaya,</p>
                <p>stays heedful,</p>
                <p>abandoning birth,</p>
                <p class="v2">the wandering-on,</p>
                <p>will put an end</p>
                <p>to suffering &amp; stress.</p>
              </div><!--end verse-add-->
            </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
