  <div id="sutta">
  
            <h4 id="thag1.114" class="h1">Thag 1:114  Adhimutta</h4>
            <div class="verse">
              <p>For one heavy</p>
              <p class="v2">with bodily offenses,</p>
              <p>greedy</p>
              <p class="v2">for carcass pleasures</p>
              <p>while life is wasting away:</p>
              <p class="v2">From where will there come</p>
              <p class="v2">contemplative-excellence?</p>
            </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
