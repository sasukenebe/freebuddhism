  <div id="sutta">
  
    <h4 id="thag1.85" class="h1">Thag 1:85  Sunāga</h4>
            <div class="verse">
              <p>Adept in a theme for the mind,</p>
              <p>sensing the savor of solitude,</p>
              <p>practicing jhāna,</p>
              <p class="v1">masterful, mindful,</p>
              <p class="v2">you’d attain a pleasure</p>
              <p class="v2">not of the flesh.<span class="fn"><a href="#thag1.85note01">1</a></span><!--end fn cite--></p>
            </div><!--end verse-->
            <div class="note">
              <p class="notetitle">Note</p><!--end notetitle-->
              <p id="thag1.85note01">1. See <a href="../../SN/SN36_31.html">SN 36:31</a>.</p>
            </div><!--end notes-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
