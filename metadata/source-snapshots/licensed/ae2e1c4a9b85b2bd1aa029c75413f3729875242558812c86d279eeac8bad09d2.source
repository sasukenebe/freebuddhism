  <div id="sutta">
  
            <h4 id="thag1.113" class="h1">Thag 1:113  Vanavaccha</h4>
            <div class="verse">
              <p>With clear waters &amp;</p>
              <p class="v2">massive boulders,</p>
              <p>frequented by monkeys &amp;</p>
              <p class="v2">deer,</p>
              <p>covered with moss &amp;</p>
              <p class="v2">water weeds:</p>
              <p>Those rocky crags refresh me.</p>
            </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
