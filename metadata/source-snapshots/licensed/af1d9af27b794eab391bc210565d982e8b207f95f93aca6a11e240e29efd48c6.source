  <div id="sutta">
  
            <h4 id="thag1.7" class="h1">Thag 1:7  Bhalliya</h4>
            <div class="verse">
              <p>Who scatters the troops</p>
              <p>of the King of Death—</p>
              <p>as a great flood,</p>
              <p>a very weak bridge made of reeds—</p>
              <p class="v2">is victorious,</p>
              <p>for his fears are dispersed.</p>
              <p class="v2">He’s tamed,</p>
              <p class="v2">unbound,</p>
              <p class="v2">steadfast in mind.</p>
            </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
