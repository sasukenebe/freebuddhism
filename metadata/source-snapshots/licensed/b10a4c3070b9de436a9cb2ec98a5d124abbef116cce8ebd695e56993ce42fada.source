  <div id="sutta">
  
            <h4 id="thag1.26" class="h1">Thag 1:26  Abhaya</h4>
            <div class="verse">
              <p>Hearing the well-spoken words</p>
              <p>of the Awakened One,</p>
              <p>Kinsman of the Sun,</p>
              <p>I pierced what is subtle—</p>
              <p class="v2">as if, with an arrow,</p>
              <p class="v2">the tip of a horse-tail hair.</p>
            </div><!--end verse-->
            <p class="seealso">See also: <a href="../../SN/SN56_45.html">SN 56:45</a></p><!--end seealso-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
