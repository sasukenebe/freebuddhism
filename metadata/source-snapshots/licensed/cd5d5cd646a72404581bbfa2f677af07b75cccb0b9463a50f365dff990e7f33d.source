  <div id="sutta">
  
    <h4 id="thag1.75" class="h1">Thag 1:75  Susārada</h4>
            <div class="verse">
              <p>Good the sight</p>
              <p>of the well-rectified:</p>
              <p class="v1">Doubt is cut off,</p>
              <p class="v1">intelligence grows.</p>
              <p>Even fools</p>
              <p>they make wise—</p>
              <p class="v1">so the company of the true</p>
              <p class="v1">is good.</p>
            </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
