  <div id="sutta">
  
    <h4 id="thag1.2" class="h1">Thag 1:2  Mahā Koṭṭhita</h4>
            <div class="verse">
              <p>Calmed, restrained,</p>
              <p>giving counsel unruffled,</p>
              <p>he shakes off evil qualities—</p>
              <p class="v2">as the breeze,</p>
              <p class="v2">a leaf from a tree.</p>
            </div><!--end verse-->
      </div><!--end:sutta-->
