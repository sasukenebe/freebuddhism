  <div id="sutta">
  
    <h4 id="thag1.73" class="h1">Thag 1:73  Māṇava</h4>
            <div class="verse">
              <p>On seeing an old person;</p>
              <p class="v1">&amp;</p>
              <p>a person in pain, diseased;</p>
              <p class="v1">&amp;</p>
              <p>a person dead, gone to life’s end,</p>
              <p class="v1">I left</p>
              <p>for the life gone forth,</p>
              <p class="v1">abandoning the sensuality</p>
              <p class="v1">that entices the heart.</p>
            </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
