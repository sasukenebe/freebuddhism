  <div id="sutta">
  
            <h4 id="thag1.84" class="h1">Thag 1:84  Nīta</h4>
            <div class="verse">
              <p>Asleep the whole night,</p>
              <p>delighting in company by day:</p>
              <p class="v2">When, when</p>
              <p class="v2">will the fool</p>
              <p class="v2">bring suffering &amp; stress</p>
              <p class="v4">to an end?</p>
            </div><!--end verse-->
      </div><!--end:sutta-->
