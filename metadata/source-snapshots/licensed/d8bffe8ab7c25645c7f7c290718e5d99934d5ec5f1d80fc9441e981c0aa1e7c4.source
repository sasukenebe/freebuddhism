  <div id="sutta">
  
            <h4 id="thag1.104" class="h1">Thag 1:104  Khitaka</h4>
            <div class="verse">
              <p>How light my body!</p>
              <p>Touched by abundant</p>
              <p>rapture &amp; bliss,</p>
              <p>—like a cotton tuft</p>
              <p>borne on the breeze—</p>
              <p>it seems to be floating</p>
              <p class="v4">—my body!</p>
            </div><!--end verse-->
      </div><!--end:sutta-->
    </div><!--end:content-->
    
